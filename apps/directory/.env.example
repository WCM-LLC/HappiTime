# ── Required (Supabase) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for server-side features (staff check-in page, contact rate-limiting):
SUPABASE_SERVICE_ROLE_KEY=

# ── Required (SMTP / contact form) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Recommended ───────────────────────────────────────────────────────────────
# SMTP_FROM=
SUPPORT_RECIPIENT_EMAIL=admin@happitime.biz
# SMTP_SECURE=

# ── Maps (optional) ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_MAPS_API_KEY=

# ── Feature flags (optional) ──────────────────────────────────────────────────
# NEXT_PUBLIC_CONSOLE_URL=https://happitime-console.vercel.app
# NEXT_PUBLIC_COMING_SOON=
# NEXT_PUBLIC_GTM_ID=
# Contributor leaderboard at /leaderboard. Server-side on purpose — do NOT
# prefix with NEXT_PUBLIC_. Anything other than exactly "true" 404s the route
# and hides the nav link. Leave unset until at least one contributor ranks;
# the board is empty until a super user's contribution is published.
# LEADERBOARD_ENABLED=
