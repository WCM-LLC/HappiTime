# ── Required ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Alternative to ANON_KEY (use one or the other):
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Menu scanning (optional) ─────────────────────────────────────────────────
# Console origin the app calls for /api/intake/* (menu scanning). Defaults to
# https://happitime-console.vercel.app; point it at a local console (e.g.
# http://192.168.x.x:3000) to test scanning against a dev server.
# EXPO_PUBLIC_CONSOLE_URL=

# ── Maps (optional) ──────────────────────────────────────────────────────────
# EXPO_PUBLIC_MAPS_PROVIDER=
# EXPO_PUBLIC_MAPS_API_KEY=
