# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-lock.yaml

# Next.js
.next/
out/

# Expo / React Native
.expo/
.expo-shared/
/android/
/ios/

# Build outputs
dist/
build/
coverage/
*.tsbuildinfo

# Supabase CLI artifacts
.supabase/
apps/web/.tools/
supabase/.temp/
supabase/.cache/
**/supabase/.temp/

# Env
.env
.env.*
apps/web/.env*
apps/mobile/.env*
# Always track example files
!.env.example
!apps/web/.env.example
!apps/mobile/.env.example
!apps/android/.env.example
!apps/directory/.env.example

# macOS
.DS_Store

# Claude Code local state
.claude/

# IntelliJ / Android Studio generated by Gradle sync
.idea/libraries/
.idea/modules/
.idea/

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Editor swap/backup files
*.swp
*.swo
*~

# Impeccable (design skill)
# Tracked: .impeccable/config.json, the DESIGN.md sidecar, and the shared hook
# in .github/hooks/. Not tracked: machine-local consent, caches, and the
# live-mode session journals, which hold absolute paths and session ids.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/live/sessions/
**/.impeccable/live/roots.json
